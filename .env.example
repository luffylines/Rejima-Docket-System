# Keep demo while testing without Supabase.
NEXT_PUBLIC_DATA_MODE=demo

# Public browser-safe values from the Rejima Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Required for Admin > Team Members account management.
# Use the Supabase secret key (sb_secret_...) or legacy service_role key.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=
