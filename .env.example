# Keep demo while testing without Supabase.
NEXT_PUBLIC_DATA_MODE=demo

# Public browser-safe values from the Rejima Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Required for Admin > Team Members account management and maintenance jobs.
# Use the Supabase secret key (sb_secret_...) or legacy service_role key.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SECRET_KEY=

# SERVER ONLY. Used by Vercel Cron to authorize automatic archive purging.
# Set this to a long random value in Vercel Environment Variables.
CRON_SECRET=
